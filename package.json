{
  "name": "resume",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "check:template": "node scripts/check-template.mjs",
    "typecheck": "tsc -b",
    "build:cf": "tsc -b && vite build --mode cloudflare",
